{
  "name": "seerr-search-filter",
  "version": "1.0.2",
  "private": true,
  "description": "Chrome extension that adds a client-side filter panel to Seerr's search results page.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json",
    "package": "cd dist && zip -r ../extension.zip . -x '*.DS_Store' && cd .."
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
